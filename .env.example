# Loopd — Environment Variables
# Copy this file to .env and fill in your API keys

# Jamendo API (https://developer.jamendo.com/)
EXPO_PUBLIC_JAMENDO_CLIENT_ID=your_jamendo_client_id

# Deezer API (public, no key needed for most endpoints)
# No key required

# Audius API (https://docs.audius.org/)
EXPO_PUBLIC_AUDIUS_APP_NAME=Loopd

# Firebase (optional for Phase 1)
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
